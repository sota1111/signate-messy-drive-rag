# ---- Competition data (SIGNATE distribution — MUST NOT be redistributed) ----
/data/
/backend/_corpus/
*.zip

# ---- Secrets / credentials ----
.env
.env.*
# Runtime adaptation layer — caches self-discovered raw secrets (passwords / alias answers).
corpus_profile.json
**/corpus_profile.json
!.env.example
*-sa-key.json
service-account*.json
application_default_credentials.json

# ---- Build / run artifacts ----
# Ignore artifacts/ contents by default, but keep the gold-100 review表 tracked (SOT-2491).
# NOTE: using `/artifacts/*` (not `/artifacts/`) so specific files can be re-included below —
# git cannot re-include a path whose parent directory itself is excluded.
/artifacts/*
# gold-100 レビュー表 — Private 限定（設問全文＋正答を含む。公開禁止）だが repo が Private なので追跡する。
!/artifacts/gold_100_review.md
!/artifacts/gold_100_review.csv
/index_store/
/.cache/
*.log
result/
scoring.csv

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- Terraform ----
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# ---- OS ----
.DS_Store
