# ===== GCP / Vertex AI =====
GCP_PROJECT_ID=signate-messy-drive-rag
# Vertex location for Gemini generation + embeddings. us-central1 has widest model availability.
VERTEX_LOCATION=us-central1
# Generation models
GEN_MODEL=gemini-2.5-flash          # default worker model (fast, cheap)
GEN_MODEL_HARD=gemini-2.5-pro       # escalation model for hard / low-confidence questions
VISION_MODEL=gemini-2.5-flash       # chart / image-PDF understanding
EMBED_MODEL=text-embedding-005      # dense retrieval embeddings

# ===== Local self-scoring (3-gate harness) =====
# Judge backend for the local CRAG proxy: "gemini" (default) or "openai".
# The OFFICIAL SIGNATE score uses OpenAI gpt-5.2 on their servers — we never need that key to submit.
JUDGE_BACKEND=gemini
JUDGE_MODEL=gemini-2.5-pro
# Independent execution gate. Enabled by default only for the question-contract ``numeric`` slice
# (derived calculations, including computed labels such as correlation argmax). Set the master to 0
# for a champion baseline, or change the comma-separated allow-list for a 関門2 candidate comparison.
GATE_EXEC_VERIFY=1
GATE_EXEC_VERIFY_CONTRACTS=numeric
# Only used if JUDGE_BACKEND=openai (optional, for exact official-parity spot checks):
# OPENAI_API_KEY=

# ===== SIGNATE =====
SIGNATE_COMPETITION_KEY=098a4365f4514c2fa197d4e16548b3bb
SIGNATE_TASK_KEY=90c19eddfdc746be88534b7e45fe1dd0

# ===== Paths (relative to repo root) =====
DATA_DIR=data
CORPUS_DIR=data/share_drive
QUESTIONS_DIR=data/questions
INDEX_DIR=index_store
ARTIFACTS_DIR=artifacts
